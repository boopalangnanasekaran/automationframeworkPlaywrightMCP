{
  "name": "playwrightautomationframeworkusingai",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:headed": "playwright test --headed",
    "test:parallel": "playwright test --workers=4",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report results/html-report",
    "lint": "eslint specs pages fixtures utils",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium firefox"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
